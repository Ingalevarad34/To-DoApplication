<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#363636"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/drawer_avatar"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/baked_goods_1"
        android:scaleType="centerCrop"
        android:background="#121212" />

    <TextView
        android:id="@+id/drawer_user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Martha Hays"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/drawer_tasks_left"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#121212"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textAlignment="center"
            android:padding="12dp"
            android:text="10 Task left" />

        <Space
            android:layout_width="8dp"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/drawer_tasks_done"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#121212"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textAlignment="center"
            android:padding="12dp"
            android:text="5 Task done" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textColor="#AFAFAF"
        android:textSize="12sp"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/drawer_app_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚙  App Settings"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:paddingVertical="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Account"
        android:textColor="#AFAFAF"
        android:textSize="12sp"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/drawer_change_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="👤  Change account name"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:paddingVertical="8dp" />

    <TextView
        android:id="@+id/drawer_change_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔑  Change account password"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:paddingVertical="8dp" />

    <TextView
        android:id="@+id/drawer_change_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📷  Change account Image"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:paddingVertical="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Uptodo"
        android:textColor="#AFAFAF"
        android:textSize="12sp"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/drawer_about_us"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ℹ  About US"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:paddingVertical="8dp" />

    <TextView
        android:id="@+id/drawer_logout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🚪  Log out"
        android:textColor="#FF4949"
        android:textSize="16sp"
        android:paddingVertical="12dp"
        android:layout_marginTop="16dp" />

</LinearLayout>
